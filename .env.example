# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Kalshi API credentials (https://kalshi.com → Settings → API Keys)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# Optional: use Kalshi's demo environment instead of live (also via `python run.py --demo`)
# TERMINAL_DEMO=1

# Subaccount that all orders/positions/fills are scoped to. 0 = main account.
# TERMINAL_SUBACCOUNT=1
